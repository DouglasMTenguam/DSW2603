# Copie para .env e ajuste os valores:  cp .env.example .env

# Banco de dados
MYSQL_ROOT_PASSWORD=troque-esta-senha
MYSQL_DATABASE=diario

# Chave do JWT (mínimo de 32 caracteres)
JWT_SECRET=troque-por-uma-chave-secreta-com-32-caracteres-ou-mais

# Portas publicadas na máquina
# (o frontend chama a API em http://localhost:8080, então mantenha 8080 no backend)
BACKEND_PORT=8080
FRONTEND_PORT=4200

TZ=America/Sao_Paulo
